# URL de la API del backend (Laravel). Se usa para el proxy /api-proxy en dev.
BACKEND_URL=http://localhost:8000
# URL pública de la API. Déjala en /api-proxy para usar el proxy de Next dev
# (evita problemas de CORS). Si apuntas directo, usa http://localhost:8000/api.
NEXT_PUBLIC_API_URL=/api-proxy

# URL pública del sitio (usada en metadata, sitemap y robots).
NEXT_PUBLIC_SITE_URL=https://elgato.pe

# Datos legales que aparecen en las páginas de términos y libro de reclamaciones.
NEXT_PUBLIC_COMPANY_LEGAL_NAME=Juguetería El Gato
NEXT_PUBLIC_COMPANY_RUC=
